# Copy this file to `.env` and fill in the values.
# `.env` is gitignored and NEVER committed — this repo is public!

# ElevenLabs API key (used by the agent for voiceover generation, README Step 4)
# The owner pastes the key; the agent writes it here and never prints it back.
ELEVENLABS_API_KEY=

# Cloudinary (image/video uploads)
# CLOUDINARY_API_SECRET must also be stored as an encrypted GitHub Actions secret.
# The cloud name and API key may be stored as GitHub Actions variables.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Agnes AI — image-to-video hook animation (stored locally or as encrypted Actions secret)
AGNES_API_KEY=
AGNES_API_BASE=https://apihub.agnes-ai.com/v1

# Fish Audio — default production narration + provider-native timestamps
FISH_API_KEY=
FISH_API_BASE=https://api.fish.audio
FISH_REFERENCE_ID=fb7ec16ca51a45a5a4db881244d7990a

# YouTube automation (encrypted Actions secrets; never paste values into docs)
YOUTUBE_STILES_CLIENT_ID=
YOUTUBE_STILES_CLIENT_SECRET=
YOUTUBE_STILES_REFRESH_TOKEN=
